# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo managed workflow (generated locally, never commit)
.expo/
expo-env.d.ts

# Expo export / web build output
dist/
web-build/

# Native projects generated by `expo prebuild` (regenerate locally, never commit)
/ios
/android

# Native signing credentials & app secrets (must never be committed)
*.jks
*.keystore
*.key
*.p8
*.p12
*.pem
*.mobileprovision
*.orig.*
google-services.json
GoogleService-Info.plist
credentials.json

# Environment files. The code currently reads no env vars, but if any are
# added later they must stay local. `.env.example` (template) stays committable.
.env
.env.*
!.env.example

# Metro bundler
.metro-health-check*

# Logs
npm-debug.*
yarn-debug.*
yarn-error.*

# TypeScript build info
*.tsbuildinfo

# Test coverage output (`npx jest --coverage`)
coverage/

# OS files
.DS_Store
._*
.Thumbs.db

# IDE / editors (local settings, never commit)
.vscode/
.idea/
*.swp
*.swo
*~

# Logs (generic)
*.log
logs/
